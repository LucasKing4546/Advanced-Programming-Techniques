<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <TableView fx:id="tableView" onMouseClicked="#onMouseClicked" prefHeight="200.0" prefWidth="409.0">
        <columns>
          <TableColumn fx:id="equationColumn" prefWidth="196.0" text="Equation" />
            <TableColumn fx:id="degreeColumn" minWidth="0.0" prefWidth="91.5" text="Degree" />
            <TableColumn fx:id="difficultyColumn" prefWidth="120.5" text="Difficulty" />
        </columns>
      </TableView>
      <ListView fx:id="listView" layoutY="200.0" prefHeight="200.0" prefWidth="409.0" />
      <TextField fx:id="degreeTextField" layoutX="427.0" layoutY="37.0" onKeyTyped="#degreeChanged" />
      <TextField fx:id="difficultyTextField" layoutX="427.0" layoutY="100.0" onKeyTyped="#difficultyChanged" />
      <TextField fx:id="coefficientTextField" layoutX="428.0" layoutY="175.0" />
      <Button fx:id="solutionButton" layoutX="469.0" layoutY="300.0" mnemonicParsing="false" onAction="#solutionButtonPressed" text="Solutions" />
      <Label layoutX="427.0" layoutY="14.0" text="Filter by Degree" />
      <Label layoutX="427.0" layoutY="73.0" text="Filter by Difficulty" />
      <Label layoutX="428.0" layoutY="148.0" text="New 'a' coefficient" />
      <Button fx:id="updateButton" layoutX="475.0" layoutY="216.0" mnemonicParsing="false" onAction="#updateButtonPressed" text="Update" />
   </children>
</AnchorPane>
