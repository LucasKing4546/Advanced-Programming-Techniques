<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<SplitPane dividerPositions="0.33, 0.66" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="500.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.Controller">
    <items>
        <VBox spacing="10.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <children>
                <Label text="Feed (Mentions &amp; Topics)">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
                <ListView fx:id="feedList" VBox.vgrow="ALWAYS" />
            </children>
        </VBox>

        <VBox spacing="10.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <children>
                <Label text="My Posts">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
                <ListView fx:id="myPostsList" VBox.vgrow="ALWAYS" />

                <TextField fx:id="postTextField" prefHeight="40.0" promptText="Write a post... (@User or #Topic)" />

                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handlePublishPost" text="Publish Post" />
            </children>
        </VBox>

        <VBox spacing="10.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <children>
                <Label text="My Subscriptions">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
                <ListView fx:id="subsList" prefHeight="150.0" VBox.vgrow="ALWAYS" />

                <Label text="Search Topics to Subscribe">
                    <font>
                        <Font name="System Italic" size="12.0" />
                    </font>
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </Label>

                <TextField fx:id="searchTopicField" onKeyTyped="#handleSearchTopic" promptText="Type to search topics..." />

                <ListView fx:id="searchResultList" onMouseClicked="#handleSubscribe" prefHeight="100.0" />
            </children>
        </VBox>
    </items>
</SplitPane>