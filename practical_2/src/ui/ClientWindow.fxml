<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<SplitPane dividerPositions="0.4" prefHeight="400.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.ClientController">
    <items>
        <VBox spacing="10.0">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <children>
                <Label text="Available Rooms"><font><Font name="System Bold" size="14.0" /></font></Label>
                <ListView fx:id="roomsList" onMouseClicked="#handleRoomSelection" VBox.vgrow="ALWAYS" />
            </children>
        </VBox>
        <VBox spacing="10.0">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <children>
                <Label text="Room Details"><font><Font name="System Bold" size="14.0" /></font></Label>
                <TextArea fx:id="descriptionArea" editable="false" prefHeight="100.0" wrapText="true" />

                <Label text="Make a Booking"><font><Font name="System Bold" size="14.0" /></font></Label>

                <TextField fx:id="typeField" promptText="Room Type (e.g. Single)" />
                <TextField fx:id="startField" promptText="Start Date (YYYY-MM-DD)" />
                <TextField fx:id="endField" promptText="End Date (YYYY-MM-DD)" />

                <Button maxWidth="Infinity" text="Book Now" onAction="#handleBooking" />
                <Label fx:id="statusLabel" textFill="blue" wrapText="true"/>
            </children>
        </VBox>
    </items>
</SplitPane>