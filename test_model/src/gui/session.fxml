<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="471.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <TableView fx:id="sessionsTableView" prefHeight="240.0" prefWidth="396.0" AnchorPane.bottomAnchor="231.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="204.0" AnchorPane.topAnchor="0.0">
        <columns>
          <TableColumn fx:id="start_time_column" prefWidth="75.0" text="Start_time" />
          <TableColumn fx:id="end_time_column" prefWidth="75.0" text="End_time" />
            <TableColumn fx:id="name_column" prefWidth="75.0" text="Name" />
            <TableColumn fx:id="intensity_column" prefWidth="75.0" text="Intensity" />
            <TableColumn fx:id="description_column" prefWidth="95.0" text="Description" />
        </columns>
      </TableView>
      <TextField fx:id="intensityTextField" layoutX="409.0" layoutY="106.0" prefHeight="25.0" prefWidth="185.0" promptText="- Insert Intensity -" />
      <Button fx:id="intensityFilterButton" layoutX="440.0" layoutY="140.0" mnemonicParsing="false" onAction="#pressFilterButton" text="Filter after intensity" />
      <Label layoutX="431.0" layoutY="78.0" text="Minimum intensity level" />
      <TextArea fx:id="descriptionText" layoutX="407.0" layoutY="199.0" prefHeight="108.0" prefWidth="185.0" promptText="- Insert description -" />
      <Label layoutX="407.0" layoutY="174.0" text="Description" />
      <Label layoutX="407.0" layoutY="323.0" text="Start time" />
      <Button fx:id="intervalsButton" layoutX="418.0" layoutY="393.0" mnemonicParsing="false" onAction="#pressIntervalsButton" text="Show intervals in total time" />
      <TextField fx:id="hoursTextField" layoutX="407.0" layoutY="347.0" prefHeight="25.0" prefWidth="185.0" promptText="- Insert number of hours -" />
      <ListView fx:id="filteredListView" layoutY="272.0" prefHeight="200.0" prefWidth="396.0" />
      <Label layoutX="14.0" layoutY="245.0" text="Filtered Items" />
   </children>
</AnchorPane>
