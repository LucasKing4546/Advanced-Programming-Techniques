<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>


<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <TableView fx:id="tableView" onMouseClicked="#onMouseClicked" prefHeight="200.0" prefWidth="376.0">
        <columns>
          <TableColumn fx:id="numberColumn" prefWidth="75.0" text="Number" />
          <TableColumn fx:id="destinationColumn" prefWidth="75.0" text="Destination" />
            <TableColumn fx:id="airlineColumn" prefWidth="75.0" text="Airline" />
            <TableColumn fx:id="durationColumn" prefWidth="75.0" text="Duration" />
            <TableColumn fx:id="statusColumn" prefWidth="75.0" text="Status" />
        </columns>
      </TableView>
      <ListView fx:id="listView" layoutY="200.0" prefHeight="200.0" prefWidth="376.0" />
      <TextField fx:id="airlineTextField" layoutX="407.0" layoutY="46.0" onKeyTyped="#airlineChanged" />
      <TextField fx:id="updateTextField" layoutX="407.0" layoutY="138.0" />
      <Button fx:id="updateButton" layoutX="456.0" layoutY="188.0" mnemonicParsing="false" onAction="#updateHandler" text="Update" />
      <Button fx:id="showArrivalButton" layoutX="441.0" layoutY="288.0" mnemonicParsing="false" onAction="#showArrivalHandler" text="Show Arrival" />
      <Label layoutX="407.0" layoutY="21.0" text="Filter by airline" />
      <Label layoutX="407.0" layoutY="114.0" text="Update duration" />
   </children>
</AnchorPane>
