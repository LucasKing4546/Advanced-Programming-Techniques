<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>


<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.UserController">
   <children>
      <SplitPane dividerPositions="0.49498327759197325" prefHeight="400.0" prefWidth="600.0">
        <items>
          <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="160.0" prefWidth="100.0">
               <children>
                  <ListView fx:id="flightsList" layoutX="13.0" layoutY="44.0" onMouseClicked="#handleFlightSelect" prefHeight="232.0" prefWidth="267.0" />
                  <Button fx:id="buyButton" layoutX="111.0" layoutY="351.0" mnemonicParsing="false" onAction="#handleBuy" text="Buy Ticket" />
                  <Label layoutX="105.0" layoutY="14.0" text="Available flights" />
                  <TextField fx:id="filterField" layoutX="73.0" layoutY="313.0" onKeyTyped="#handleFilter" />
                  <Label layoutX="114.0" layoutY="289.0" text="Filter Flights" />
               </children>
            </AnchorPane>
          <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="160.0" prefWidth="100.0">
               <children>
                  <ListView fx:id="ticketsList" layoutX="20.0" layoutY="44.0" onMouseClicked="#handleTicketSelect" prefHeight="282.0" prefWidth="260.0" />
                  <Label layoutX="123.0" layoutY="14.0" text="My tickets" />
                  <Button fx:id="cancelButton" layoutX="108.0" layoutY="344.0" mnemonicParsing="false" onAction="#handleCancel" text="Cancel ticket" />
               </children>
            </AnchorPane>
        </items>
      </SplitPane>
   </children>
</AnchorPane>
